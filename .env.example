# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the assistant calls from (E.164, e.g. +15551234567)
TWILIO_PHONE_NUMBER=
# Your mobile number - the only number it calls and the only caller it answers
OWNER_PHONE_NUMBER=
# Public https URL of this server, no trailing slash (e.g. https://my-assistant.onrender.com)
PUBLIC_BASE_URL=
# Long random string; protects the /call-now endpoint
ADMIN_TOKEN=

# --- Schedule ---------------------------------------------------------------
TIMEZONE=America/New_York
# name=HH:MM, comma separated
CHECKIN_TIMES=morning=07:00,late-morning=11:00,midday=12:30,evening=20:00
# 0=Mon ... 6=Sun
CHECKIN_DAYS=0,1,2,3,4,5,6

# --- Optional ---------------------------------------------------------------
ASSISTANT_MODEL=claude-opus-5-5
# low keeps phone replies fast; raise to medium/high for more careful answers
ASSISTANT_EFFORT=low
OWNER_NAME=Teo
# Twilio <Say> voice
VOICE=Polly.Joanna-Neural
DATA_DIR=./data
START_SCHEDULER=true

# Gmail (run scripts/gmail_auth.py to get the refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
